                "value": "[variables('vnet2subnet1Name')]"
              },            
              "adminUsername": {
                "value": "[parameters('adminUsername')]"
              },                                                                                                            
              "adminPassword": {
                "value": "[parameters('adminPassword')]"
              },  
              "TimeZone": {
                  "value": "[parameters('TimeZone')]"
              },
              "AutoShutdownEnabled": {
                  "value": "[parameters('AutoShutdownEnabled')]"
              },                             
              "AutoShutdownTime": {
                  "value": "[parameters('AutoShutdownTime')]"
