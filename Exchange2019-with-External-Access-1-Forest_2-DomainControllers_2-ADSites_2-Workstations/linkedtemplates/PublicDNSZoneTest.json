{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "ZoneName": {
            "type": "string",
            "metadata": {
                "description": "DNS Zone Name"
              }
        }                               
    }, 
    "resources": [
        {
            "name": "[parameters('ZoneName')]",
            "type": "Microsoft.Network/dnsZones",
            "apiVersion": "2018-05-01",
            "location": "global",
            "tags": {},
            "properties": {
            },
            "resources": []
        }                                        
    ],
    "outputs": {
        "NameServers": {
            "type": "Array",
            "value": "[string(reference(resourceId(resourceGroup().name, 'Microsoft.Network/dnszones', parameters('ZoneName'))).nameServers[0])]"
        },
        "NameServer1": {
            "type": "String",
            "value": "[reference('NameServers').outputs.NameServers.value]"
        }        
    }
}